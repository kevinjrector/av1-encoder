<Window x:Class="Av1Encoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Av1Encoder"
        Title="AV1 Encoder"
        Icon="Assets/app.ico"
        Width="1000" Height="700" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <local:EqualsConverter x:Key="EqualsConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="CardDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="MinHeight" Value="16" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Source Folder" Click="OpenSourceFolder_Click" />
                <MenuItem Header="Open _Destination Folder" Click="OpenDestinationFolder_Click" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Logs">
                <MenuItem Header="Open Logs _Folder" Click="OpenLogsFolder_Click" />
                <MenuItem Header="Open _app.log" Click="OpenAppLog_Click" />
                <MenuItem Header="Open _encodes.jsonl" Click="OpenEncodesLog_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" VerticalAlignment="Center" Margin="0,0,12,8" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,8"
                     Text="{Binding Source}" IsEnabled="{Binding IsIdle}" LostFocus="FolderBox_LostFocus" />
            <Button Grid.Row="0" Grid.Column="2" Content="Browse..." MinWidth="96" Margin="0,0,0,8"
                    IsEnabled="{Binding IsIdle}" Click="BrowseSource_Click" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Destination" VerticalAlignment="Center" Margin="0,0,12,8" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,8"
                     Text="{Binding Destination}" IsEnabled="{Binding IsIdle}" LostFocus="FolderBox_LostFocus" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." MinWidth="96" Margin="0,0,0,8"
                    IsEnabled="{Binding IsIdle}" Click="BrowseDestination_Click" />

            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,4,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Text="Workers" VerticalAlignment="Center" Margin="0,0,16,4" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton Content="1" GroupName="Workers" MinWidth="80"
                                 IsChecked="{Binding Workers, Converter={StaticResource EqualsConverter}, ConverterParameter=1}" />
                    <RadioButton Content="2" GroupName="Workers" MinWidth="80"
                                 IsChecked="{Binding Workers, Converter={StaticResource EqualsConverter}, ConverterParameter=2}" />
                    <RadioButton Content="3" GroupName="Workers" MinWidth="80"
                                 IsChecked="{Binding Workers, Converter={StaticResource EqualsConverter}, ConverterParameter=3}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Quality" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                    <RadioButton Content="Low" GroupName="Quality" MinWidth="80"
                                 ToolTip="Smallest files, about half the size of Default. Detail is visibly softer."
                                 IsChecked="{Binding Quality, Converter={StaticResource EqualsConverter}, ConverterParameter=Low}" />
                    <RadioButton Content="Default" GroupName="Quality" MinWidth="80"
                                 ToolTip="Balanced size and quality."
                                 IsChecked="{Binding Quality, Converter={StaticResource EqualsConverter}, ConverterParameter=Default}" />
                    <RadioButton Content="High" GroupName="Quality" MinWidth="80"
                                 ToolTip="Closest to the original, about 1.5 times the size of Default."
                                 IsChecked="{Binding Quality, Converter={StaticResource EqualsConverter}, ConverterParameter=High}" />
                </StackPanel>

                <StackPanel Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start" MinWidth="110" Margin="0,0,8,0"
                            Style="{DynamicResource AccentButtonStyle}"
                            IsEnabled="{Binding IsIdle}" Click="Start_Click" />
                    <Button Content="Stop" MinWidth="110"
                            IsEnabled="{Binding IsRunning}" Click="Stop_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,-12,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Completed" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding CompletedText}" Style="{StaticResource CardValue}" />
                        <TextBlock Text="{Binding FailedText}" Style="{StaticResource CardDetail}" Foreground="IndianRed" Opacity="1" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Space saved" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding SavedText}" Style="{StaticResource CardValue}" />
                        <TextBlock Text="{Binding SavedDetail}" Style="{StaticResource CardDetail}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Time left" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource CardValue}" />
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource CardDetail}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,12">
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="Install ffmpeg" Margin="12,0,0,0"
                            Visibility="{Binding FfmpegMissing, Converter={StaticResource BooleanToVisibility}}"
                            IsEnabled="{Binding CanInstallFfmpeg}" Click="InstallFfmpeg_Click" />
                </Grid>
            </StackPanel>

            <DataGrid Grid.Row="5" Grid.ColumnSpan="3"
                      ItemsSource="{Binding Jobs}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Single">
                <DataGrid.Resources>
                    <Style x:Key="CellText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="100" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SourceSize}" Width="90" ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Header="Progress" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Minimum="0" Maximum="100" Height="6" Margin="4,0" VerticalAlignment="Center"
                                             Value="{Binding Progress, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="70" ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Header="Status" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Foreground" Value="IndianRed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
